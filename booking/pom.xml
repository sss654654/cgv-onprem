<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 이미지 스캔이 app.jar 에서 찾는 CVE 는 대부분 이 부모가 버전을 정하는 것들에서
             나온다 — tomcat · spring · jackson · netty · kafka-clients. 개별로 고정하지 않고
             부모를 최신 패치로 올려 함께 따라오게 한다. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.cgv</groupId>
    <artifactId>booking</artifactId>
    <version>0.0.1</version>
    <name>cgv-booking</name>
    <description>CGV 예매(booking) 서비스 — 좌석 점유·결제·확정. queue(Go)와 Kafka로 연결.</description>

    <properties>
        <java.version>21</java.version>
        <!-- 부모 3.5.16 이 주는 netty 는 4.1.135.Final 이고, CVE-2026-59901(bzip2 디코더
             무한루프)의 수정판은 4.1.136.Final 이다. 부모가 정한 버전을 이 한 줄이 덮는다.
             다음 부모 패치가 4.1.136 이상을 실으면 이 줄을 지운다. -->
        <netty.version>4.1.136.Final</netty.version>
        <!-- 부모 3.5.16 이 주는 tomcat-embed-core 는 10.1.55 이고, CVE-2026-65182(보안 제약
             우회) · CVE-2026-65905(DIGEST 인증 재전송) · CVE-2026-68525(FORM 인증 우회)가
             거기 걸린다. 셋 다 인증·접근 제어를 지나가는 결함이라 공개 경로에 그대로 노출된다.
             권고 수정판은 10.1.58 인데 그 버전은 Maven Central 에 배포되지 않았다
             (10.1.57 다음이 10.1.59). 그래서 10.1.59 로 올린다.
             다음 부모 패치가 10.1.59 이상을 실으면 이 줄을 지운다. -->
        <tomcat.version>10.1.59</tomcat.version>
    </properties>

    <dependencies>
        <!-- REST API -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 영구 기록·트랜잭션(JPA/Hibernate) — booking 핵심(정합성) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- 임시 점유(좌석락)·입장 인증(admitted) — Redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- queue와의 서비스간 통신(admissions 소비 / bookings-completed 발행) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <!-- 요청 검증 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MySQL 드라이버 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 관측: Actuator = readiness(/actuator/health) + metric 통로(/actuator/prometheus).
             Micrometer Prometheus registry = HikariCP·JVM·HTTP·Kafka 지표를 Prometheus 포맷으로. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 관측 로그: JSON 구조화 로그(logback → STDOUT). MDC(traceId·spanId) 포함 → Loki 파싱. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
        <!-- 관측 trace: Micrometer Observation → OTel 브리지 + OTLP 익스포터.
             코드 수술 없음 — HTTP·Kafka observation이 자동 span 생성, OTLP로 Tempo에 전송.
             버전은 Spring Boot 3.3.4 BOM이 관리(micrometer-tracing·opentelemetry BOM). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- 관측 trace: SQL 구간. DataSource를 감싸 질의마다 span을 남긴다(코드 수술 없음).
             이게 없으면 예매 확정 요청의 span이 HTTP 하나뿐이라, 느린 한 건을 열어도
             커넥션 풀에서 기다린 것인지 질의가 느린 것인지 안 갈린다 —
             hikaricp_connections_pending은 그 순간 몇 건이 대기 중인지만 알려주고
             "이 요청"이 거기 있었는지는 답하지 않는다.
             버전은 부모 BOM이 관리하지 않아 직접 적는다. 1.1.x는 Spring Boot 3.4 계열을 기준으로
             빌드돼 이 프로젝트(3.5.16)와 가깝다 — 1.0.x는 3.0 기준이라 간격이 크다. -->
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-spring-boot</artifactId>
            <version>1.1.1</version>
        </dependency>

        <!-- 테스트 전용. scope=test 라 실행 이미지에는 들어가지 않는다. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 정적 분석. 컴파일된 바이트코드를 훑어 null 역참조·자원 미해제·오버라이드
                 실수처럼 컴파일은 통과하지만 런타임에 터지는 자리를 찾는다.
                 CI 에서 mvn compile spotbugs:check 로 호출한다. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.3.0</version>
                <configuration>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
