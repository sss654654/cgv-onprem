# 프론트 게이트웨이 — 정적 서빙 + API 리버스 프록시.
# 브라우저는 여기(한 진입점)만 본다. /api/admission/* → queue, 나머지 /api/* → booking.
# k3s에선 이 역할을 Ingress(Traefik)가 대신함 → 경로 규칙 그대로 이관 가능.
#   단 /api/movies 만은 k3s에서도 이 nginx로 보낸다(Ingress 경로 추가) — 아래 캐시 때문이다.

# 영화 목록 응답 캐시.
# 첫 화면(영화목록)은 입장 전 진입점이라 대기열 게이트 밖에 있다. 방문자 전원이 부른다.
#   실측(2026-08-18, 사용자 5,000명): 판 시작 3초 안에 booking CPU 0.51코어·스로틀 81.8%,
#   readiness 프로브가 떨어졌다. 대기열이 뒷단을 지키는데 이 경로만 그 보호 밖이었다.
# 목록은 영화가 추가될 때만 바뀌므로 초 단위로 낡아도 화면이 틀리지 않는다.
#   proxy_cache_lock: 캐시가 비었을 때 동시 요청 중 하나만 booking으로 보내고 나머지는 기다린다.
#   이게 없으면 캐시 만료 순간마다 같은 몰림이 그대로 재현된다.
# 경로는 이미 붙어 있는 쓰기 가능한 emptyDir 안이다(readOnlyRootFilesystem=true 라 그 밖은 못 쓴다).
proxy_cache_path /var/cache/nginx/movies levels=1:2 keys_zone=movies:1m max_size=8m inactive=10m;

server {
    listen 8080;   # nginx-unprivileged(비루트) — k3s restricted PSA.
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # 보안 헤더 — 프록시가 아니라 앱이 낸다.
    # k3s 에서는 Traefik Middleware(app-security-headers)가 이 Ingress 의 라우터 전부에 걸었다.
    #   EKS 에서는 ALB 가 임의 헤더를 못 붙여서 프록시가 그 일을 못 한다.
    #   앱이 내면 앞에 무엇이 있든 응답이 같아진다.
    # HSTS 는 https 응답에 실려야 브라우저가 기억한다. 양쪽 환경 모두 앞단이 TLS 를 끝낸다 —
    #   dev 는 Cloudflare, stg 는 ALB(ACM 인증서)다. 그 앞단이 평문으로 열려 있으면 이 헤더는 무시된다.
    # max-age 는 브라우저가 "이 도메인은 https 로만 간다" 를 기억하는 기간이다. 짧게 두면 그 기간이 지난
    #   첫 접속이 다시 평문으로 나가 가로채기에 열린다. 표준 권고값인 1년으로 둔다.
    #   서브도메인까지 걸지 않는다(includeSubDomains 없음) — 같은 도메인 아래 https 가 아닌 이름이
    #   하나라도 있으면 그것까지 접속이 끊긴다.
    add_header Strict-Transport-Security "max-age=31536000"  always;
    add_header X-Content-Type-Options    "nosniff"           always;
    add_header X-Frame-Options           "DENY"              always;
    # 다른 사이트로 나갈 때 이 서비스의 경로를 넘기지 않는다. 경로에 회차 · 좌석 식별자가 들어간다.
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    # 업스트림 주소는 변수로 둔다 — proxy_pass 에 변수가 있으면 nginx 가 이름을
    #   기동 시점이 아니라 요청 시점에 푼다. 리터럴이면 기동 때 한 번만 푸는데,
    #   그 순간 클러스터 DNS(CoreDNS)가 아직 없으면 기동 자체를 거부한다
    #   → 클러스터 전체가 재부팅될 때마다 CoreDNS 가 뜰 때까지 반복 재시작.
    # 요청 시점 해석은 /etc/resolv.conf 를 안 쓴다 → resolver 로 DNS 를 직접 지정.
    #   search 목록도 안 타므로 서비스 이름은 FQDN 으로 쓴다.
    # 주소가 환경마다 다르다. 이미지에 리터럴로 두면 그 이미지가 한 환경에서만 돈다 —
    #   이 파일이 .template 인 이유이고, 컨테이너가 뜰 때 엔트리포인트가 이 값을 채운다.
    #   k3s 10.43.0.10 · EKS 172.20.0.10 · docker compose 127.0.0.11(도커 내장 DNS)
    resolver ${DNS_RESOLVER} valid=30s ipv6=off;   # 30초 캐시로 매 요청 조회를 피한다
    set $queue   http://queue.app.svc.cluster.local:8090;
    set $booking http://booking.app.svc.cluster.local:8091;

    # queue(입장 통제): enter·position(폴링)·leave·complete
    # SSE 스트림 대신 폴링을 쓰므로 스트림 location 없음 — 짧은 요청·응답이라 버퍼off 불필요.
    location /api/admission/ {
        proxy_pass $queue;
    }

    # 영화 목록 — 캐시해서 booking 으로 나가는 요청을 초당 1건 이하로 만든다.
    # location 이 /api/ 보다 길어 nginx 의 최장 일치가 여기를 먼저 고른다.
    location /api/movies {
        proxy_pass $booking;
        proxy_cache movies;
        proxy_cache_valid 200 10s;      # 10초. 영화 추가가 그만큼 늦게 보인다
        proxy_cache_lock on;            # 캐시가 빈 순간 booking 으로 나가는 요청은 하나뿐
        proxy_cache_lock_timeout 5s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        # booking 이 죽어도 낡은 목록으로 화면이 뜬다 — 대기열은 계속 돈다
        # ★ nginx 의 add_header 는 "이 층에 add_header 가 하나도 없을 때만" 윗층 것을 물려받는다.
        #   아래 한 줄 때문에 server 층의 보안 헤더 셋이 이 location 에서 통째로 사라진다.
        #   그래서 여기서 다시 적는다. 지우면 조용히 헤더가 빠진다.
        add_header X-Cache-Status $upstream_cache_status;   # HIT/MISS 확인용
        add_header Strict-Transport-Security "max-age=31536000"  always;
        add_header X-Content-Type-Options    "nosniff"           always;
        add_header X-Frame-Options           "DENY"              always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    }

    # booking(예매): screenings·seats·bookings
    location /api/ {
        proxy_pass $booking;
    }

    # SPA — 정적 파일, 없으면 index.html(클라 라우팅)
    # no-cache: 파일명에 해시가 없어 캐시버스팅 수단이 없음 → 재배포 시 구버전이 보이는 것 방지.
    # 데모 규모라 매 요청 재검증 비용 무시 가능. (조건부 요청이라 304로 싸게 끝남.)
    location / {
        # 위 /api/movies 와 같은 이유로 보안 헤더를 다시 적는다 — 이 층에 add_header 가 있으면
        #   server 층 것을 안 물려받는다. 첫 화면이 나가는 자리라 빠지면 가장 크게 걸린다.
        add_header Cache-Control "no-cache";
        add_header Strict-Transport-Security "max-age=31536000"  always;
        add_header X-Content-Type-Options    "nosniff"           always;
        add_header X-Frame-Options           "DENY"              always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ /index.html;
    }
}
